# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=agent-supervision-tree
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys, one list per scope.
# Generate a key with: uv run agent-supervision-tree generate-api-key
APP_API_KEY_SHA256=
APP_ADMIN_API_KEY_SHA256=
APP_FAULT_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none
APP_LOOP_LAG_THRESHOLD_SECONDS=0.5

# LLM provider. Without ANTHROPIC_API_KEY the service runs the seeded fault-injecting fake
# model at APP_FAULT_RATE; tests, demo and bench never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EXTRACTOR_MODEL=claude-sonnet-5
APP_LLM_FALLBACK_MODEL=claude-haiku-4-5
APP_LLM_ALLOW_DEFER=true
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_FAULT_RATE=0.3

# Supervision tree.
APP_WORKERS=4
APP_MAILBOX_CAPACITY=64
APP_WORKER_MAILBOX_CAPACITY=8
APP_MAX_MESSAGE_BYTES=65536
APP_MESSAGE_TTL_SECONDS=10
APP_MAX_ATTEMPTS=3
APP_MAX_RESTARTS=5
APP_MAX_RESTART_SECONDS=5
APP_PROVIDER_CALL_TIMEOUT_SECONDS=2
APP_PROVIDER_BULKHEAD=8
APP_QUARANTINE_MAX_RECORDS=10000
APP_BUDGET_MAX_TOKENS=2000000
APP_BUDGET_MAX_USD=5.0
APP_WEBHOOK_URL=https://hooks.example.internal/invoices
# Fault injection routes exist only when true (they also need a fault-scope key).
APP_FAULTS_ENABLED=false

APP_DATA_DIR=var
# Optional: write the runtime audit chain to this file as well as keeping it in memory.
APP_AUDIT_LOG_PATH=
